NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Clé "service_role" (Dashboard Supabase → Project Settings → API). Ne
# JAMAIS préfixer NEXT_PUBLIC_ : elle ne doit être lue que côté serveur
# (API routes / server actions) et ne doit jamais atteindre le navigateur.
# Nécessaire pour /admin/vendeurs (création de comptes vendeurs + avatars).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
